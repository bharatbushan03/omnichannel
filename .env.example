# LLM + embeddings (NVIDIA NIM — free tier, get key at https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
POSTGRES_DSN=postgresql://user:password@localhost:5432/knowledge_agent

# Slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Meeting ingestion (Zoom/Google Meet via Recall.ai)
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# Voice engine
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
