# LLM + embeddings (NVIDIA NIM — free tier, get key at https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Storage — passwords match docker-compose.yml for local development
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword
POSTGRES_DSN=postgresql://agent:localdevpassword@localhost:5432/knowledge_agent

# development | production. Production refuses to start until encryption is attested.
APP_ENV=development
# disk | managed. Required when APP_ENV=production (volume or managed TDE).
ENCRYPTION_AT_REST=unconfigured

# true withholds retrieval results when the audit insert fails
AUDIT_FAIL_CLOSED=false

# Webhook requests allowed per client per minute (Slack, Teams, Recall.ai)
WEBHOOK_RATE_LIMIT=60

# Retention purge (days). Run: python -m ingestion.retention
CHUNK_TTL_DAYS=365
MEETING_TTL_DAYS=90
AUDIT_TTL_DAYS=730

# Slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Teams gateway (Slack-style HMAC; see ingestion/teams_listener.py)
TEAMS_WEBHOOK_SECRET=

# Meeting ingestion (Zoom/Google Meet via Recall.ai)
RECALL_API_KEY=
RECALL_API_BASE=https://us-east-1.recall.ai/api/v1
RECALL_WEBHOOK_SECRET=
RECALL_REALTIME_WEBHOOK_URL=
# Protects POST /meetings/start
INGESTION_ADMIN_TOKEN=
# one_party | two_party | all_party. Default is the stricter two_party.
MEETING_JURISDICTION=two_party
# stop | exclude_speaker. all_party always stops the whole meeting.
MEETING_ON_OBJECTION=stop

# Text agent (Slack mentions/DMs, Teams chats, meeting wake phrase,
# Discord /ask, WhatsApp, and Jira comments). Repo tools read this directory.
AGENT_WORKSPACE=
AGENT_WORKSPACE_ID=ws_demo

# Discord interactions endpoint (ed25519 public key from the application)
DISCORD_PUBLIC_KEY=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=

# Jira Cloud. The bot account id stops the agent from answering its own comments.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
JIRA_BOT_ACCOUNT_ID=

# Teams reply token (Bot Framework bearer). Inbound verification uses TEAMS_WEBHOOK_SECRET.
TEAMS_BOT_TOKEN=

# Voice engine
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
